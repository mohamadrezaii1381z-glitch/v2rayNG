<resources>
    <color name="window_background_light">#FFFFFFFF</color>
    <color name="window_background_dark">#FF1C1B1F</color>

    <style name="AppThemeBaseCommon" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/window_background_light</item>
    </style>

    <!-- HardVPN: fixed dark-navy window so the HardVPN UI never flashes a light system background.
         The activity also pins AppCompatDelegate to night mode; the Compose HardVpnTheme supplies
         the in-app palette. -->
    <color name="window_background_hardvpn">#FF040A18</color>

    <style name="AppThemeHardVpn" parent="AppThemeBaseCommon">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/window_background_hardvpn</item>
        <item name="android:statusBarColor">@color/window_background_hardvpn</item>
        <item name="android:navigationBarColor">@color/window_background_hardvpn</item>
    </style>

    <!-- API 27+ adds navigation bar icon appearance in the versioned base theme. -->
    <style name="AppThemeBase" parent="AppThemeBaseCommon" />

    <style name="AppThemeDayNight" parent="AppThemeBase" />

    <style name="AppThemeDayNight.NoActionBar" parent="AppThemeBase" />

    <style name="AppThemeDayNight.NoActionBar.Translucent" parent="AppThemeBase">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
    </style>
</resources>
